		(uuid "177decf9-744d-43aa-ac3c-8654be8fd6aa")
	)
	(text "Virtual GND (V/2)"
		(exclude_from_sim no)
		(at 244.348 70.866 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.254)
				(bold yes)
			)
		)
		(uuid "34d43895-c283-4821-9cc9-67d4ee1ce400")
	)
	(text "Current limit:\n18V @470R\n=38mA"
		(exclude_from_sim no)
		(at 100.33 150.114 0)
		(effects
			(font
				(size 1.016 1.016)
				(thickness 0.1875)
			)
			(justify left bottom)
		)
		(uuid "4c1a0b41-c47d-43ef-867e-5ac949e4a094")
	)
	(text "Cutoff f:\nC = 2.2uF\nR = 15k\n\nHigh pass:\nfc = 4.8Hz"
		(exclude_from_sim no)
		(at 56.388 40.386 0)
		(effects
			(font
				(size 1.016 1.016)
				(thickness 0.1875)
			)
			(justify left bottom)
		)
		(uuid "63e87688-3e43-49f4-a395-6217206f58c7")
	)
	(text "By default, the most noise-critical circuit\nelements are chosen from TI, as they provide\nthe most specs and, for the price, best\ncomponents.\n\nAlternatives for:\nRef		18V			5V*\nU1,2:\n\nU3: 	PJ71K33SC	PJ71K50SC\nSGM2203 A GOOD CANDIDATE:\nhttps://www.lcsc.com/datasheet/C4555486.pdf\n\n*Read modification notes!"
		(exclude_from_sim no)
		(at 234.95 147.066 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "7185f7df-aa09-45fe-b499-d92635ff491b")
	)
	(text "Cutoff f:\nC = 22nF\nR = 47R\n\nLow pass:\nfc = 154kHz"
		(exclude_from_sim no)
		(at 137.922 89.916 0)
		(effects
			(font
				(size 1.016 1.016)
				(thickness 0.1875)
			)
			(justify left bottom)
		)
		(uuid "7e0cf478-d70f-4a6d-bb01-803a6ac4d4cc")
	)
	(text "By default, the circuit uses 18V to power the OPA1652\nand uses the PJ71K30 to supply 3V to the MEMS mics.\n\nIf you are using a 5V OpAmp instead, you need to do a few\nmodifications. First is to make sure to pick the 5V LDO\n(PJ71K50SC for U3) which will be supplying the 5V OpAmp.\nNext, cut the traces between 1-2 on both (JP2, JP3) \nsolder jumpers, and solder across 2-3. This will then\nsupply OPA_Pwr (5V) and power the MEMS with V/2 (2.5V)\n"
		(exclude_from_sim no)
		(at 153.416 148.844 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "bb17f0c1-a242-4a08-b979-3e73322576d7")
	)
	(text "Total current consumption:\n\n1x OPA1652 = 2x 2.5mA = 5mA \n1x PJ71K30 = 1x 5uA\n1x MEMS = 1x 200uA = 0.2mA\nvolt div. = 0.6mA\n\nTotal per channel: 6mA @ 18V\n(rest in Zener)"
		(exclude_from_sim no)
		(at 50.292 147.32 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "d89dc10a-602a-47a9-ad59-3d366bf441c6")
	)
	(text "Cutoff f:\nC = 14.4uF\nR = 470R\n\nLow pass:\nfc = 23Hz"
		(exclude_from_sim no)
		(at 87.63 153.924 0)
		(effects
			(font
				(size 1.016 1.016)
				(thickness 0.1875)
			)
			(justify left bottom)
		)
		(uuid "e684f912-49d3-437c-a162-abe3aa49eda9")
	)
